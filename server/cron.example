# Nightly safety mirror (in case the hook failed during the day)
15 2 * * * git --git-dir=/srv/git/keeis-brain.git push --mirror github

# Weekly digest (Monday 06:00). Schedule ONLY after testing it by hand twice.
0 6 * * 1 cd /srv/keeis-brain && git pull --ff-only && claude -p "$(cat server/jobs/weekly-digest.md)" >> /var/log/keeis-digest.log 2>&1
